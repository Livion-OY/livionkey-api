  {
    "type": "post",
    "url": "/accessrights",
    "title": "POST /accessrights",
    "version": "3.5.0",
    "name": "AccessrightsPost",
    "group": "Accessrights",
    "permission": [
      {
        "name": "authenticated"
      }
    ],
    "description": "<p>Accessright create for keypad</p>",
    "header": {
      "fields": {
        "Header": [
          {
            "group": "Header",
            "type": "String",
            "optional": false,
            "field": "authorization",
            "description": "<p>authorization JWT token <code>Bearer {token}</code></p>"
          }
        ]
      }
    },
    "parameter": {
      "fields": {
        "body": [
          {
            "group": "body",
            "type": "String",
            "optional": false,
            "field": "accessRightId",
            "description": "<p>Mandatory accessRightId.</p>"
          },
          {
            "group": "body",
            "type": "Object[]",
            "optional": false,
            "field": "devices",
            "description": "<p>Mandatory devices. Array of id: device ID</p>"
          },
          {
            "group": "body",
            "type": "String",
            "optional": false,
            "field": "start",
            "description": "<p>Mandatory start time of access.</p>"
          },
          {
            "group": "body",
            "type": "String",
            "optional": false,
            "field": "person",
            "description": "<p>Mandatory accessRight owner (person name).</p>"
          },
          {
            "group": "body",
            "type": "Object[]",
            "optional": false,
            "field": "contacts",
            "description": "<p>Mandatory list of contacts with fields: email: String, phoneNumber: String, sendSms: Boolean, sendEmail: Boolean, language: String ('fi-fi', 'en-gb', 'swe-swe', 'no-no', 'da-da').</p>"
          },
          {
            "group": "body",
            "type": "String",
            "optional": true,
            "field": "end",
            "description": "<p>Optional end time of accessRight, if not null perm should false/null.</p>"
          },
          {
            "group": "body",
            "type": "String",
            "optional": true,
            "field": "perm",
            "description": "<p>Optional permanent accessRight, if true end should be null.</p>"
          },
          {
            "group": "body",
            "type": "String",
            "optional": true,
            "field": "freeText",
            "description": "<p>Optional free Tezt to be added as a complement to email templates</p>"
          },
          {
            "group": "body",
            "type": "String",
            "optional": true,
            "field": "pincode",
            "description": "<p>Optional pincode. If pincode is not provided api will generate it.</p>"
          },
          {
            "group": "body",
            "type": "Boolean",
            "optional": true,
            "field": "modifyTime",
            "defaultValue": "true",
            "description": "<p>Flag to control time modification. If set to <code>false</code>, the start and end times are used exactly as provided, without changing them to the beginning or end of the day.</p>"
          },
          {
            "group": "body",
            "type": "Object[]",
            "optional": true,
            "field": "recurrent",
            "description": "<p>Optional recurrent. Array of object [{ startTime: String, endTime: String, days: {0: true, 1:true, 2:false, 3:false, 4:true, 5:true,6:true }] }], Days is an object representing days 0 to 6 with vlue as boolean. if true, accessRight is valid during that day between startTime and endTime.</p>"
          }
        ]
      },
      "examples": [
        {
          "title": "Request-Example:",
          "content": "{\n  \"accessRightId\": \"543553\"\n  \"devices\": [{\"id\": \"123456\"}]\n  \"start\": \"2018-02-14T08:06:30.000Z\"\n  \"end\": \"2018-02-17T08:06:30.000Z\"\n  \"person\": \"John Doe\",\n  \"contacts\": [{\"email\": \"john.doe@livion.fi\", \"phoneNumber\": \"+358123456789\", \"sendEmail\": true, \"sendSms\": false, \"language\": \"fi-fi\"}]\n  \"recurrent\": [{ \"startTime\": '08:00', \"endTime\": '17:00', \"days\": {0: true, 1:true, 2:true, 3:true, 4:true, 5:false, 6:false }] }]\n}",
          "type": "json"
        }
      ]
    },
    "success": {
      "fields": {
        "Success 200": [
          {
            "group": "Success 200",
            "type": "String",
            "optional": false,
            "field": "id",
            "description": "<p>AccessRight id</p>"
          },
          {
            "group": "Success 200",
            "type": "String",
            "optional": false,
            "field": "pincode",
            "description": "<p>Generated pincode</p>"
          }
        ]
      },
      "examples": [
        {
          "title": "Success-Response:",
          "content": "HTTP/1.1 200 OK\n{\n  \"id\": \"a668e8f7f686a79879b976c65\"\n  \"pincode\": \"594395\"\n}",
          "type": "json"
        }
      ]
    },
    "error": {
      "fields": {
        "Error 4xx": [
          {
            "group": "Error 4xx",
            "type": "String",
            "optional": false,
            "field": "400",
            "description": "<p>Missing accessRight parameters <br />Missing deviceId from parameters <br />Missing accessRightId from parameters <br />Missing start from parameters <br />Missing person from parameters <br />Missing contacts from parameters <br />Missing end from parameters <br />No devices <br />Device is not a keypad <br />AccessId already in use <br />KeyId not found <br />Start time should be before End time <br />Start time should be in the future <br />Overlapping accessRight existing <br />Pincode already used in existing accessRights</p>"
          }
        ]
      }
    },
    "filename": "./routers/accessrights.js",
    "groupTitle": "Accessrights"
  },
